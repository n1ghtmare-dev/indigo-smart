# === Backend (FastAPI) → MySQL из FastPanel на хосте ===
# Имя пользователя MySQL, созданного в FastPanel (например, indigosmart_app)
DB_USER=indigosmart_user

# Пароль этого пользователя MySQL (создаётся в FastPanel)
DB_PASSWORD=replace-with-real-password

# Имя базы данных в FastPanel (например, indigosmart_smarthome)
DB_NAME=indigosmart_db

# Секрет для подписи JWT-токенов. Сгенерировать: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# === Frontend (React) ===
# Публичный URL backend API, как его видит браузер пользователя
# Через nginx FastPanel /api → 127.0.0.1:8000 (см. docs/deploy-server-setup.md шаг 8)
REACT_APP_API_URL=https://indigosmart.ru/api
